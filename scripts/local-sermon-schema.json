{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "topicId": {
      "type": "string",
      "enum": ["passage", "anxiety", "discouragement", "loneliness", "relationship", "forgiveness", "work", "finances", "direction", "guilt", "grief", "pain", "anger", "burnout", "general-care"]
    },
    "urgent": {
      "type": "string",
      "enum": ["none", "self_harm", "violence", "both", "harm_to_others", "complex_danger"]
    },
    "sermon": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 90 },
        "summary": { "type": "string", "maxLength": 700 },
        "opening": { "type": "string", "maxLength": 700 },
        "context": { "type": "string", "maxLength": 800 },
        "passageSections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "integer", "minimum": 1 },
              "end": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "maxLength": 100 },
              "explanation": { "type": "string", "maxLength": 800 }
            },
            "required": ["start", "end", "title", "explanation"],
            "additionalProperties": false
          }
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string", "maxLength": 100 },
              "body": { "type": "string", "maxLength": 900 }
            },
            "required": ["title", "body"],
            "additionalProperties": false
          }
        },
        "illustration": { "type": "string", "maxLength": 800 },
        "crossReferences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "reference": { "type": "string", "maxLength": 80 },
              "connection": { "type": "string", "maxLength": 500 }
            },
            "required": ["reference", "connection"],
            "additionalProperties": false
          }
        },
        "applications": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "maxLength": 400 }
        },
        "caution": { "type": "string", "maxLength": 500 },
        "questions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "maxLength": 250 }
        },
        "decision": { "type": "string", "maxLength": 700 },
        "prayer": { "type": "string", "maxLength": 700 },
        "manuscript": {
          "type": "object",
          "properties": {
            "estimatedMinutes": { "type": "integer", "minimum": 9, "maximum": 18 },
            "introduction": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": { "type": "string", "minLength": 120, "maxLength": 700 }
            },
            "sections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "properties": {
                  "start": { "type": "integer", "minimum": 1 },
                  "end": { "type": "integer", "minimum": 1 },
                  "heading": { "type": "string", "maxLength": 100 },
                  "paragraphs": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 6,
                    "items": { "type": "string", "minLength": 140, "maxLength": 850 }
                  },
                  "bridgeToNext": { "type": "string", "minLength": 30, "maxLength": 320 }
                },
                "required": ["start", "end", "heading", "paragraphs", "bridgeToNext"],
                "additionalProperties": false
              }
            },
            "gospelConnection": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": { "type": "string", "minLength": 120, "maxLength": 700 }
            },
            "conclusion": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "type": "string", "minLength": 120, "maxLength": 700 }
            },
            "closingPrayer": { "type": "string", "minLength": 180, "maxLength": 800 }
          },
          "required": ["estimatedMinutes", "introduction", "sections", "gospelConnection", "conclusion", "closingPrayer"],
          "additionalProperties": false
        }
      },
      "required": ["title", "summary", "opening", "context", "passageSections", "points", "illustration", "crossReferences", "applications", "caution", "questions", "decision", "prayer", "manuscript"],
      "additionalProperties": false
    }
  },
  "required": ["topicId", "urgent", "sermon"],
  "additionalProperties": false
}
